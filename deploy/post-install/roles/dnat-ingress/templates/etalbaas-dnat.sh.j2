#!/bin/bash
# EtalBaaS DNAT rules: redirect external 80/443 to Envoy Gateway NodePorts.
# Managed by Ansible (dnat-ingress role). Do not edit manually.
set -euo pipefail

IFACE="{{ dnat_external_interface }}"

add_rule() {
  local port="$1" target="$2"
  # Add only if not already present (-i $IFACE scopes to external traffic only)
  if ! iptables -t nat -C PREROUTING -i "$IFACE" -p tcp --dport "$port" -j DNAT --to-destination ":$target" 2>/dev/null; then
    # Insert after CILIUM_PRE_nat (position 2) if it exists, otherwise position 1
    local pos=1
    if iptables -t nat -L PREROUTING -n --line-numbers 2>/dev/null | grep -q CILIUM_PRE_nat; then
      pos=2
    fi
    iptables -t nat -I PREROUTING "$pos" -i "$IFACE" -p tcp --dport "$port" \
      -j DNAT --to-destination ":$target" \
      -m comment --comment "etalbaas: DNAT $port to Envoy NodePort $target"
    echo "Added DNAT :$port -> :$target at position $pos"
  else
    echo "DNAT :$port -> :$target already exists"
  fi
}

add_rule 80  {{ envoy_nodeport_http }}
add_rule 443 {{ envoy_nodeport_https }}
