---
# Ansible Vault encrypted variables template.
# Copy to vault.yml and encrypt with: ansible-vault encrypt vault.yml
#
# IMPORTANT: .vault-password file must exist (not committed to Git).
# Store the vault password in a password manager.

# Sealed Secrets private key (TLS keypair)
# Initial setup: generate with openssl, then paste base64 here.
# Recovery: reuse the existing key to decrypt old SealedSecrets.
sealed_secrets_tls_crt: "<base64-encoded public certificate>"
sealed_secrets_tls_key: "<base64-encoded private key>"

# ArgoCD admin password (bcrypt hash)
# Generate: htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n' | sed 's/$2y/$2a/'
argocd_admin_password_hash: "<bcrypt hash>"

# Cloudflare API Token (DNS edit permission for the zone)
cloudflare_api_token: "<cloudflare-api-token>"

# Cloudflare Zone ID
cloudflare_zone_id: "<zone-id>"
