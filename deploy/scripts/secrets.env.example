# EtalBaaS — K8s Secrets for kubeseal
#
# Setup:
#   cp secrets.env.example secrets.env
#   # fill in real values
#   bash deploy/scripts/seal-secrets.sh
#
# This file is committed to Git as a template.
# NEVER commit the real secrets.env.

# ─── Platform Secrets (platform-secrets) ───────────────────────────────────
JWT_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth (leave blank to skip)
GITHUB_OAUTH_SECRET=
GOOGLE_OAUTH_SECRET=

# ─── GoTrue Asymmetric JWT (optional, Phase 2) ────────────────────────────
# Path to a JWK Set JSON file for RS256 signing.
GOTRUE_JWK_SET_FILE=

# ─── Cloudflare (DNS + cert-manager) ──────────────────────────────────────
CLOUDFLARE_API_TOKEN=

# ─── GHCR Pull Secret (container registry) ───────────────────────────────
GHCR_USERNAME=
GHCR_TOKEN=

# ─── S3 Backup Credentials (CNPG barman) ─────────────────────────────────
# Required only if metadb backup is enabled in main.yml.
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=

# ─── Discord Alerting (optional) ─────────────────────────────────────────
DISCORD_WEBHOOK_URL=
