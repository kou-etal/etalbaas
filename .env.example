# EtalBaaS - Local Development Environment Variables
# Copy this file to .env and fill in the values.
# Usage: source .env && go run ./cmd/ (in any service directory)

# === Common (all services) ===
PORT=8080
METRICS_PORT=9090
DATABASE_URL=postgres://etalbaas:password@localhost:5432/etalbaas?sslmode=disable
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENV=development
JWT_SECRET=dev-secret-change-me

# === Storage MS ===
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=etalbaas-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_USE_SSL=false

# === Function MS ===
K8S_ENABLED=false
